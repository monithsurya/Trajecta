<mujoco model="roboforge_simple_arm">
  <!-- Compiler and Physics Options -->
  <compiler angle="radian" coordinate="local" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <!-- Default geom properties for contacts -->
    <geom condim="4" friction="1.0 0.005 0.0001" margin="0.001"/>
    <!-- Default joint damping to ensure stable numerical simulation -->
    <joint damping="0.5" armature="0.01"/>
  </default>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
  </visual>

  <worldbody>
    <!-- Floor plane -->
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.85 0.85 0.85 1.0"/>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>

    <!-- Work table -->
    <body name="table" pos="0.35 0.0 0.15">
      <geom name="table_geom" type="box" size="0.25 0.3 0.15" rgba="0.5 0.4 0.35 1.0"/>
    </body>

    <!-- Target manipulation object: A simple 5cm cube on the table -->
    <body name="cube" pos="0.35 0.0 0.325">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" rgba="0.9 0.2 0.2 1.0" mass="0.05"/>
    </body>

    <!-- 2-DOF Articulated Robot Arm mounted on a pedestal -->
    <body name="arm_base" pos="0 0 0">
      <!-- Fixed pedestal base -->
      <geom name="pedestal" type="cylinder" size="0.06 0.1" pos="0 0 0.1" rgba="0.25 0.25 0.28 1.0"/>

      <!-- Link 1 (Upper arm): rotates around y-axis (shoulder pitch) -->
      <body name="link1" pos="0 0 0.2">
        <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-1.5708 1.5708"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0.25 0 0" size="0.035" rgba="0.2 0.5 0.8 1.0" mass="1.0"/>

        <!-- Link 2 (Forearm): rotates around y-axis (elbow pitch) -->
        <body name="link2" pos="0.25 0 0">
          <joint name="elbow_pitch" type="hinge" axis="0 1 0" range="-2.0944 2.0944"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.2 0 0" size="0.028" rgba="0.25 0.7 0.4 1.0" mass="0.8"/>

          <!-- End-effector tip indicator for future grasping / reaching -->
          <body name="ee_tip" pos="0.2 0 0">
            <geom name="ee_geom" type="sphere" size="0.02" rgba="0.95 0.6 0.1 1.0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Actuators: Position servos mapping normalized target setpoints to joint limits -->
  <actuator>
    <position name="actuator_shoulder" joint="shoulder_pitch" kp="50" kv="5" ctrlrange="-1.5708 1.5708"/>
    <position name="actuator_elbow" joint="elbow_pitch" kp="40" kv="4" ctrlrange="-2.0944 2.0944"/>
  </actuator>
</mujoco>
